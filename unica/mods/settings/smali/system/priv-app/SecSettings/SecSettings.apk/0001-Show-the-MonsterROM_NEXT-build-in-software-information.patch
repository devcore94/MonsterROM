From: MonsterROM_NEXT <monsterrom@localhost>
Subject: [PATCH] Show the MonsterROM_NEXT build in software information

diff --git a/res/xml/sec_software_info_settings.xml b/res/xml/sec_software_info_settings.xml
--- a/res/xml/sec_software_info_settings.xml
+++ b/res/xml/sec_software_info_settings.xml
@@ -2,6 +2,7 @@
 <PreferenceScreen android:title="@string/device_info_software_title" settings:hierarchicalParentFragment="com.samsung.android.settings.deviceinfo.aboutphone.SecMyDeviceInfoFragment" settings:topLevelPreferenceKey="top_level_about_phone"
   xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
     <Preference android:enabled="false" android:title="@string/one_ui_version_title" android:key="one_ui_version" android:summary="@string/summary_placeholder" android:shouldDisableView="false" settings:controller="com.samsung.android.settings.deviceinfo.softwareinfo.OneUIVersionPreferenceController" />
+    <Preference android:enabled="false" android:title="MonsterROM_NEXT" android:key="monsterrom_version" android:summary="@string/summary_placeholder" android:shouldDisableView="false" settings:controller="com.samsung.android.settings.deviceinfo.softwareinfo.MonsterRomVersionPreferenceController" />
     <Preference android:title="@string/firmware_version" android:key="android_firmware_version" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionDetailPreferenceController" />
     <Preference android:title="@string/module_version" android:key="module_version" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.deviceinfo.firmwareversion.MainlineModuleVersionPreferenceController" />
     <Preference android:title="@string/baseband_version" android:key="base_band" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.deviceinfo.firmwareversion.BasebandVersionPreferenceController" />
diff --git a/smali_classes3/com/samsung/android/settings/deviceinfo/softwareinfo/MonsterRomVersionPreferenceController.smali b/smali_classes3/com/samsung/android/settings/deviceinfo/softwareinfo/MonsterRomVersionPreferenceController.smali
new file mode 100644
--- /dev/null
+++ b/smali_classes3/com/samsung/android/settings/deviceinfo/softwareinfo/MonsterRomVersionPreferenceController.smali
@@ -0,0 +1,37 @@
+.class public Lcom/samsung/android/settings/deviceinfo/softwareinfo/MonsterRomVersionPreferenceController;
+.super Lcom/android/settings/core/BasePreferenceController;
+.source "MonsterRomVersionPreferenceController.java"
+
+
+# direct methods
+.method public constructor <init>(Landroid/content/Context;Ljava/lang/String;)V
+    .locals 0
+
+    invoke-direct {p0, p1, p2}, Lcom/android/settings/core/BasePreferenceController;-><init>(Landroid/content/Context;Ljava/lang/String;)V
+
+    return-void
+.end method
+
+
+# virtual methods
+.method public getAvailabilityStatus()I
+    .locals 1
+
+    const/4 v0, 0x0
+
+    return v0
+.end method
+
+.method public getSummary()Ljava/lang/CharSequence;
+    .locals 2
+
+    const-string v0, "ro.unica.version"
+
+    sget-object v1, Landroid/os/Build;->DISPLAY:Ljava/lang/String;
+
+    invoke-static {v0, v1}, Landroid/os/SystemProperties;->get(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;
+
+    move-result-object v0
+
+    return-object v0
+.end method
-- 

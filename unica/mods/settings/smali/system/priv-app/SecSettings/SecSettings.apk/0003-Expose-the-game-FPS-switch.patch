From: MonsterROM_NEXT <monsterrom@localhost>
Subject: [PATCH] Add the localized per-game FPS switch to MonsterROM settings

diff --git a/res/xml/monsterrom_settings.xml b/res/xml/monsterrom_settings.xml
--- a/res/xml/monsterrom_settings.xml
+++ b/res/xml/monsterrom_settings.xml
@@ -6,4 +6,5 @@
     <SecPreference android:title="@string/dual_app_title" android:key="dual_app" settings:controller="com.samsung.android.settings.usefulfeature.dualmessenger.DualMessengerPreferenceController" />
     <Preference android:icon="@drawable/ic_settings_multiuser" android:title="@string/user_settings_title" android:key="system_multiuser" android:fragment="com.android.settings.users.UserSettings" settings:controller="com.android.settings.users.MultiUserPreferenceController" />
     <PreferenceScreen android:title="@string/device_info_software_title" android:key="software_info" android:fragment="com.samsung.android.settings.deviceinfo.softwareinfo.SoftwareInfoSettings" settings:controller="com.samsung.android.settings.deviceinfo.softwareinfo.SoftwareInfoPreferenceController" settings:keywords="@string/keywords_device_info_software_settings" />
+    <SecSwitchPreference android:title="@string/unica_games_spoof_title" android:key="unica_games_spoof" settings:controller="io.mesalabs.unica.settings.extra.GamesPropsPreferenceController" />
 </PreferenceScreen>
diff --git a/smali_classes4/io/mesalabs/unica/settings/extra/GamesPropsPreferenceController.smali b/smali_classes4/io/mesalabs/unica/settings/extra/GamesPropsPreferenceController.smali
new file mode 100644
--- /dev/null
+++ b/smali_classes4/io/mesalabs/unica/settings/extra/GamesPropsPreferenceController.smali
@@ -0,0 +1,73 @@
+.class public Lio/mesalabs/unica/settings/extra/GamesPropsPreferenceController;
+.super Lcom/android/settings/core/TogglePreferenceController;
+.source "GamesPropsPreferenceController.java"
+
+
+# direct methods
+.method public constructor <init>(Landroid/content/Context;Ljava/lang/String;)V
+    .locals 0
+
+    invoke-direct {p0, p1, p2}, Lcom/android/settings/core/TogglePreferenceController;-><init>(Landroid/content/Context;Ljava/lang/String;)V
+
+    return-void
+.end method
+
+
+# virtual methods
+.method public getAvailabilityStatus()I
+    .locals 0
+
+    :try_start_0
+    const-string p0, "io.mesalabs.unica.GamesPropsUtils"
+
+    invoke-static {p0}, Ljava/lang/Class;->forName(Ljava/lang/String;)Ljava/lang/Class;
+    :try_end_0
+    .catch Ljava/lang/ClassNotFoundException; {:try_start_0 .. :try_end_0} :catch_0
+
+    const/4 p0, 0x0
+
+    return p0
+
+    :catch_0
+    const/4 p0, 0x3
+
+    return p0
+.end method
+
+.method public isChecked()Z
+    .locals 1
+
+    const-string p0, "persist.sys.unica.gamehooks"
+
+    const/4 v0, 0x1
+
+    invoke-static {p0, v0}, Landroid/os/SemSystemProperties;->getBoolean(Ljava/lang/String;Z)Z
+
+    move-result p0
+
+    return p0
+.end method
+
+.method public isControllable()Z
+    .locals 0
+
+    const/4 p0, 0x1
+
+    return p0
+.end method
+
+.method public setChecked(Z)Z
+    .locals 0
+
+    const-string p0, "persist.sys.unica.gamehooks"
+
+    invoke-static {p1}, Ljava/lang/Boolean;->toString(Z)Ljava/lang/String;
+
+    move-result-object p1
+
+    invoke-static {p0, p1}, Landroid/os/SemSystemProperties;->set(Ljava/lang/String;Ljava/lang/String;)V
+
+    const/4 p0, 0x1
+
+    return p0
+.end method

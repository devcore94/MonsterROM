From: MonsterROM_NEXT <monsterrom@localhost>
Subject: [PATCH] Port the Samsung HMA app picker to the MonsterROM settings page

diff --git a/res/xml/monsterrom_settings.xml b/res/xml/monsterrom_settings.xml
--- a/res/xml/monsterrom_settings.xml
+++ b/res/xml/monsterrom_settings.xml
@@ -7,4 +7,5 @@
     <Preference android:icon="@drawable/ic_settings_multiuser" android:title="@string/user_settings_title" android:key="system_multiuser" android:fragment="com.android.settings.users.UserSettings" settings:controller="com.android.settings.users.MultiUserPreferenceController" />
     <PreferenceScreen android:title="@string/device_info_software_title" android:key="software_info" android:fragment="com.samsung.android.settings.deviceinfo.softwareinfo.SoftwareInfoSettings" settings:controller="com.samsung.android.settings.deviceinfo.softwareinfo.SoftwareInfoPreferenceController" settings:keywords="@string/keywords_device_info_software_settings" />
     <SecSwitchPreference android:title="@string/unica_games_spoof_title" android:key="unica_games_spoof" settings:controller="io.mesalabs.unica.settings.extra.GamesPropsPreferenceController" />
+    <SecSwitchPreferenceScreen android:persistent="false" android:title="@string/unica_hma_title" android:key="monsterrom_hma" android:fragment="io.mesalabs.unica.settings.hma.HideMyApplistFragment" settings:controller="io.mesalabs.unica.settings.hma.HideMyApplistPreferenceController" />
 </PreferenceScreen>
diff --git a/res/layout/monsterrom_hma_picker.xml b/res/layout/monsterrom_hma_picker.xml
new file mode 100644
--- /dev/null
+++ b/res/layout/monsterrom_hma_picker.xml
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
+    <include layout="@layout/camera_flash_notification_app_picker_header" />
+    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
+        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="8dp" android:paddingBottom="12dp"
+        android:textAppearance="?android:attr/textAppearanceSmall" android:text="@string/monsterrom_hma_hint" />
+    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
+        <androidx.picker.widget.SeslAppPickerListView android:id="@id/app_picker_view"
+            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
+        <ProgressBar android:id="@android:id/progress" android:layout_gravity="center"
+            android:layout_width="wrap_content" android:layout_height="wrap_content" />
+        <TextView android:id="@android:id/empty" android:layout_gravity="center" android:gravity="center"
+            android:layout_width="wrap_content" android:layout_height="wrap_content"
+            android:text="@string/no_applications" android:visibility="gone" />
+    </FrameLayout>
+</LinearLayout>

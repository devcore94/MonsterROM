From: MonsterROM_NEXT <monsterrom@localhost>
Subject: [PATCH] Add MonsterROM_NEXT controls to the One UI settings homepage

diff --git a/res/xml/sec_top_level_settings.xml b/res/xml/sec_top_level_settings.xml
--- a/res/xml/sec_top_level_settings.xml
+++ b/res/xml/sec_top_level_settings.xml
@@ -103,6 +103,7 @@
             <extra android:name="from_settings" android:value="true" />
         </intent>
     </com.android.settings.widget.HomepagePreference>
+    <com.android.settings.widget.HomepagePreference android:icon="@drawable/sec_ic_settings_monsterrom" android:title="@string/monsterrom_name" android:key="top_level_monsterrom" android:order="350000" android:fragment="com.samsung.android.settings.monsterrom.MonsterRomSettings" />
     <com.android.settings.widget.HomepagePreference android:icon="@drawable/sec_ic_settings_about" android:title="@string/sec_about_settings" android:key="top_level_about_phone" android:summary="@string/summary_placeholder" android:order="400000" android:fragment="com.samsung.android.settings.deviceinfo.aboutphone.SecMyDeviceInfoFragment" settings:controller="com.samsung.android.settings.deviceinfo.aboutphone.SecTopLevelAboutDevicePreferenceController" settings:highlightableMenuKey="@string/menu_key_about_device" settings:keywords="@string/keywords_about_settings" />
     <com.android.settings.widget.HomepagePreference android:icon="@drawable/ic_settings_development" android:title="@string/development_settings_title" android:key="top_level_developer_options" android:summary="@string/development_settings_title" android:order="500000" android:fragment="com.android.settings.development.DevelopmentSettingsDashboardFragment" settings:controller="com.samsung.android.settings.homepage.TopLevelDeveloperOptionsPreferenceController" settings:highlightableMenuKey="@string/menu_key_developer_options" />
     <com.android.settings.widget.HomepagePreference android:icon="@drawable/sec_ic_settings_dex" android:title="@string/sec_samsung_dex" android:key="top_level_dex_settings" android:summary="@string/summary_placeholder" android:order="-600000" settings:controller="com.samsung.android.settings.homepage.TopLevelDexSettingsController" settings:highlightableMenuKey="@string/menu_key_dex">
diff --git a/res/values/strings.xml b/res/values/strings.xml
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -19845,4 +19845,5 @@
     <string name="zone_time_type_standard">Standard time</string>
     <string name="zzz_lgt_password_wrong_pin_code1">The PIN was entered incorrectly %d time.</string>
     <string name="zzz_lgt_password_wrong_pin_code2">After 3 incorrect PIN attempts, you have to enter the personal unlocking key (PUK).</string>
+    <string name="monsterrom_name" translatable="false">MonsterROM_NEXT</string>
 </resources>
diff --git a/res/drawable/sec_ic_settings_monsterrom.xml b/res/drawable/sec_ic_settings_monsterrom.xml
new file mode 100644
--- /dev/null
+++ b/res/drawable/sec_ic_settings_monsterrom.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<layer-list
+  xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <shape android:shape="oval">
+            <solid android:color="@color/sec_dashboard_about_phone_color" />
+            <size android:height="@dimen/sec_dashboard_tile_image_size" android:width="@dimen/sec_dashboard_tile_image_size" />
+        </shape>
+    </item>
+    <item android:gravity="center" android:drawable="@drawable/ic_monsterrom_mark" />
+</layer-list>
diff --git a/res/drawable/ic_monsterrom_mark.xml b/res/drawable/ic_monsterrom_mark.xml
new file mode 100644
--- /dev/null
+++ b/res/drawable/ic_monsterrom_mark.xml
@@ -0,0 +1,5 @@

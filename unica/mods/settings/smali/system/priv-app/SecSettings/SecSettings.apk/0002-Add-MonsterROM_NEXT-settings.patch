+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
+    <path android:fillColor="#ffffffff" android:pathData="M4,18V6h2.8L12,12.6L17.2,6H20v12h-2.7v-7.4L12,17l-5.3,-6.4V18z" />
+</vector>
diff --git a/res/xml/monsterrom_settings.xml b/res/xml/monsterrom_settings.xml
new file mode 100644
--- /dev/null
+++ b/res/xml/monsterrom_settings.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:settings="http://schemas.android.com/apk/res-auto" android:title="@string/monsterrom_name">
+    <SwitchPreferenceCompat android:persistent="false" android:title="@string/real_time_network_speed_title" android:key="network_speed" settings:controller="com.samsung.android.settings.notification.StatusBarNetworkSpeedController" />
+    <SecPreferenceScreen android:persistent="false" android:title="@string/power_off_lock_title" android:key="power_off_lock" android:summary="@string/power_off_lock_description" android:fragment="com.samsung.android.settings.security.PowerOffLockOptionFragment" settings:controller="com.samsung.android.settings.security.PowerOffLockPreferenceController" settings:keywords="@string/keywords_power_off_lock" />
+    <SecPreference android:title="@string/dual_app_title" android:key="dual_app" settings:controller="com.samsung.android.settings.usefulfeature.dualmessenger.DualMessengerPreferenceController" />
+    <Preference android:icon="@drawable/ic_settings_multiuser" android:title="@string/user_settings_title" android:key="system_multiuser" android:fragment="com.android.settings.users.UserSettings" settings:controller="com.android.settings.users.MultiUserPreferenceController" />
+    <PreferenceScreen android:title="@string/device_info_software_title" android:key="software_info" android:fragment="com.samsung.android.settings.deviceinfo.softwareinfo.SoftwareInfoSettings" settings:controller="com.samsung.android.settings.deviceinfo.softwareinfo.SoftwareInfoPreferenceController" settings:keywords="@string/keywords_device_info_software_settings" />
+</PreferenceScreen>

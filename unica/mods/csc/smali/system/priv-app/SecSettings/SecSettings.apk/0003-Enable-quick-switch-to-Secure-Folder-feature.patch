From: MonsterROM_NEXT <monsterrom@localhost>
Subject: [PATCH] Offer the side key action when Secure Folder is installed

diff --git a/smali_classes4/com/samsung/android/settings/usefulfeature/Usefulfeature$1.smali b/smali_classes4/com/samsung/android/settings/usefulfeature/Usefulfeature$1.smali
--- a/smali_classes4/com/samsung/android/settings/usefulfeature/Usefulfeature$1.smali
+++ b/smali_classes4/com/samsung/android/settings/usefulfeature/Usefulfeature$1.smali
@@ -250,7 +250,7 @@
 
     iput-object v1, v0, Lcom/android/settingslib/search/SearchIndexableRaw;->keywords:Ljava/lang/String;
 
-    const-string/jumbo v1, "com.samsung.android.aliveprivacy"
+    const-string/jumbo v1, "com.samsung.knox.securefolder"
 
     invoke-static {p1, v1}, Lcom/android/settings/Utils;->hasPackage(Landroid/content/Context;Ljava/lang/String;)Z
 
diff --git a/smali_classes4/com/samsung/android/settings/usefulfeature/functionkey/item/SecureFolderAction.smali b/smali_classes4/com/samsung/android/settings/usefulfeature/functionkey/item/SecureFolderAction.smali
--- a/smali_classes4/com/samsung/android/settings/usefulfeature/functionkey/item/SecureFolderAction.smali
+++ b/smali_classes4/com/samsung/android/settings/usefulfeature/functionkey/item/SecureFolderAction.smali
@@ -49,7 +49,7 @@
 
     sput-byte v0, Lcom/samsung/android/settings/usefulfeature/functionkey/item/SecureFolderAction;->pressType:B
 
-    const-string/jumbo v0, "com.samsung.android.aliveprivacy"
+    const-string/jumbo v0, "com.samsung.knox.securefolder"
 
     sput-object v0, Lcom/samsung/android/settings/usefulfeature/functionkey/item/SecureFolderAction;->PRIVATEMODE_PACKAGE_NAME:Ljava/lang/String;
 
@@ -83,7 +83,7 @@
     goto :goto_0
 
     :catch_0
-    const-string/jumbo v2, "Package not found: com.samsung.android.aliveprivacy"
+    const-string/jumbo v2, "Package not found: com.samsung.knox.securefolder"
 
     invoke-static {v1, v2}, Landroid/util/Log;->e(Ljava/lang/String;Ljava/lang/String;)I
 
@@ -92,7 +92,7 @@
     :goto_0
     if-eqz v2, :cond_0
 
-    const-string/jumbo v5, "use icon from spay app info: com.samsung.android.aliveprivacy"
+    const-string/jumbo v5, "use icon from spay app info: com.samsung.knox.securefolder"
 
     invoke-static {v1, v5}, Landroid/util/Log;->e(Ljava/lang/String;Ljava/lang/String;)I
 

; Added by unica/mods/prophide One UI 9; no property-area writes outside init.
(type prophide_stage)
(roletype object_r prophide_stage)
(typeattributeset domain (prophide_stage))
(typeattributeset coredomain (prophide_stage))
(type prophide_stage_exec)
(roletype object_r prophide_stage_exec)
(typeattributeset file_type (prophide_stage_exec))
(typeattributeset exec_type (prophide_stage_exec))
(typeattributeset system_file_type (prophide_stage_exec))
(typetransition init prophide_stage_exec process prophide_stage)
(allow init prophide_stage (process (transition siginh rlimitinh)))
(allow init prophide_stage_exec (file (read getattr map execute open)))
(allow prophide_stage prophide_stage_exec (file (entrypoint read getattr map execute open)))
; Read only the exact block FD opened by init before dropping to system UID.
; No open, ioctl, generic block read, capability, or shell execution grant.
(allow prophide_stage block_device (dir (search)))
(allow prophide_stage vbmeta_block_device (blk_file (read getattr)))
(allow prophide_stage vendor_security_patch_level_prop (file (read getattr map open)))
(type unica_prophide_stage_prop)
(roletype object_r unica_prophide_stage_prop)
(type unica_prophide_result_prop)
(roletype object_r unica_prophide_result_prop)
(typeattributeset property_type (unica_prophide_stage_prop unica_prophide_result_prop))
(typeattributeset system_property_type (unica_prophide_stage_prop unica_prophide_result_prop))
(typeattributeset system_internal_property_type (unica_prophide_stage_prop unica_prophide_result_prop))
(allow prophide_stage property_socket (sock_file (write)))
(allow prophide_stage init (unix_stream_socket (connectto)))
(allow prophide_stage unica_prophide_stage_prop (property_service (set)))
(allow prophide_stage unica_prophide_stage_prop (file (read getattr map open)))
(allow prophide_stage unica_prophide_result_prop (file (read getattr map open)))
(typeattribute unica_prophide_not_stage_writer)
(typeattributeset unica_prophide_not_stage_writer (and (domain) (not (init prophide_stage))))
(neverallow unica_prophide_not_stage_writer unica_prophide_stage_prop (property_service (set)))
(typeattribute unica_prophide_not_result_writer)
(typeattributeset unica_prophide_not_result_writer (and (domain) (not (init))))
(neverallow unica_prophide_not_result_writer unica_prophide_result_prop (property_service (set)))

service prophide-stage /system/bin/prophide_stage
    user system
    group system
    disabled
    oneshot
    file /dev/block/by-name/vbmeta r

on property:service.bootanim.exit=1
    start prophide-stage

# Platform action: these socket requests originate in the real PID 1.
# Native CheckPermissions remains before the exact-value init-only adapter.
on property:service.bootanim.exit=1 && property:sys.unica.prophide.ready=1
    setprop sys.unica.prophide.ready 0
    setprop ro.boot.flash.locked 1
    setprop ro.boot.vbmeta.avb_version 1.3
    setprop ro.boot.vbmeta.device_state locked
    setprop ro.boot.vbmeta.digest ${sys.unica.prophide.vbmeta_digest}
    setprop ro.boot.vbmeta.hash_alg sha256
    setprop ro.boot.vbmeta.invalidate_on_error yes
    setprop ro.boot.vbmeta.public_key_digest ${sys.unica.prophide.vbmeta_public_key_digest}
    setprop ro.boot.vbmeta.size ${sys.unica.prophide.vbmeta_size}
    setprop ro.boot.warranty_bit 0
    setprop ro.boot.verifiedbootstate green
    setprop ro.boot.veritymode enforcing
    setprop ro.vendor.boot.warranty_bit 0
    setprop ro.vendor.build.security_patch ${sys.unica.prophide.security_patch}
    setprop sys.unica.prophide.result.vendor_warranty_bit ${ro.vendor.boot.warranty_bit}
    # Handoff complete; only the helper's subsequent status=verified is success.
    setprop sys.unica.prophide.result.done 1

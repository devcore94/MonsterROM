+++ b/smali_classes2/com/android/systemui/media/colorfulwave/renderer/MultiWaveAreaTrackRenderer$WaveStyle.smali
@@ -64,6 +64,12 @@
 
     iput p11, p0, Lcom/android/systemui/media/colorfulwave/renderer/MultiWaveAreaTrackRenderer$WaveStyle;->jitter:F
 
+    const/16 p1, 0xa
+
+    invoke-static {p12, p1}, Ljava/lang/Math;->max(II)I

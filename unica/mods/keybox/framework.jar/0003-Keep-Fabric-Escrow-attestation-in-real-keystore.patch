From: UN1CA One UI 9 compatibility
Subject: [PATCH] Keep Fabric Escrow attestation key in real Keystore2

The Fabric Escrow vault attests ev2_TaSignCert through SamsungAttestation,
which talks to real Keystore2. Never serve this alias from the imitation
database, including an entry left by an older build.

diff --git a/smali_classes6/io/mesalabs/unica/KeyboxUtils.smali b/smali_classes6/io/mesalabs/unica/KeyboxUtils.smali
--- a/smali_classes6/io/mesalabs/unica/KeyboxUtils.smali
+++ b/smali_classes6/io/mesalabs/unica/KeyboxUtils.smali
@@ -215,6 +215,17 @@
         }
     .end annotation
 
+    invoke-static {p0}, Lio/mesalabs/unica/KeyboxUtils;->isFabricEscrowAttestationKey(Landroid/system/keystore2/KeyDescriptor;)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_fabric_keybox
+
+    const/4 v0, 0x0
+
+    return-object v0
+
+    :cond_fabric_keybox
     iget v0, p0, Landroid/system/keystore2/KeyDescriptor;->domain:I
 
     const/4 v1, 0x4
@@ -1872,5 +1883,24 @@
 .end method
 
+.method static blacklist isFabricEscrowAttestationKey(Landroid/system/keystore2/KeyDescriptor;)Z
+    .locals 2
+
+    const/4 v0, 0x0
+
+    if-eqz p0, :cond_0
+
+    iget-object p0, p0, Landroid/system/keystore2/KeyDescriptor;->alias:Ljava/lang/String;
+
+    const-string v1, "ev2_TaSignCert"
+
+    invoke-virtual {v1, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    :cond_0
+    return v0
+.end method
+
 .method static synthetic blacklist lambda$isCallerSamsungKeystoreUtils$0(Ljava/lang/StackTraceElement;)Z
     .locals 1
 

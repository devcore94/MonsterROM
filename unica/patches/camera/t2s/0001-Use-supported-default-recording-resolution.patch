Subject: [PATCH] Use One UI 9 Camera recording-default syntax on t2s

The new Resolution parser expects a size and optional numeric frame rate.
The legacy AUTO suffix produces -1 and crashes Camera settings startup.
Use the donor's valid 1080p default; the separate auto-FPS option is retained.

--- a/system/cameradata/camera-feature.xml
+++ b/system/cameradata/camera-feature.xml
@@ -51,7 +51,7 @@
     <local name="FRONT_CAMERA_SENSOR_CROP_RESOLUTION_1BY1_LARGE" value="2208x2208"/>
 
     <!-- Recording resolution - BACK -->
-    <local name="BACK_CAMERA_RECORDING_DEFAULT_RESOLUTION" value="1920x1080_AUTO"/>
+    <local name="BACK_CAMERA_RECORDING_DEFAULT_RESOLUTION" value="1920x1080"/>
     <local name="BACK_CAMERA_RECORDING_MIN_RESOLUTION" value="1280x720"/>
     <local name="BACK_CAMCORDER_RESOLUTION_FEATURE_MAP_7680X4320_24FPS" value="true" hdr="true" hdr10="false" snapshot-support="true" snapshot-size="4032x2268" vdis="true" super-vdis="false" effect="false" object-tracking="false" seamless-zoom-support="false" physical-zoom-supported="false" external-storage-support="false" touch-af="true" supported-mode="video,pro_video"/>
     <local name="BACK_CAMCORDER_RESOLUTION_FEATURE_MAP_3840X2160" value="true" hdr="true" hdr10="true" snapshot-support="true" snapshot-size="4032x2268" vdis="true" super-vdis="false" effect="false" object-tracking="true" seamless-zoom-support="true" physical-zoom-supported="false" external-storage-support="true" touch-af="true" supported-mode="video,pro_video"/>
@@ -77,6 +77,6 @@
 
     <!-- Recording resolution - FRONT -->
-    <local name="FRONT_CAMERA_RECORDING_DEFAULT_RESOLUTION" value="1920x1080_AUTO"/>
+    <local name="FRONT_CAMERA_RECORDING_DEFAULT_RESOLUTION" value="1920x1080"/>
     <local name="FRONT_CAMERA_RECORDING_MIN_RESOLUTION" value="1280x720"/>
     <local name="FRONT_CAMCORDER_RESOLUTION_FEATURE_MAP_3840X2160" value="true" hdr="true" hdr10="false" snapshot-support="true" snapshot-size="3968x2232" vdis="true" super-vdis="false" effect="false" object-tracking="false" external-storage-support="true" touch-af="true" supported-mode="video"/>
     <local name="FRONT_CAMCORDER_RESOLUTION_FEATURE_MAP_3840X2160_60FPS" value="true" hdr="true" hdr10="false" snapshot-support="true" snapshot-size="3968x2232" vdis="true" super-vdis="false" effect="false" object-tracking="false" external-storage-support="false" touch-af="false" supported-mode="video"/>

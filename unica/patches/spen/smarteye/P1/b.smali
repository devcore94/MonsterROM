# The former SDL facade now uses the same real One UI 9 backend, not absent SDL APIs.
.class public final LP1/b;
.super LN1/b;

.method public constructor <init>(Landroid/content/Context;)V
    .locals 0
    invoke-direct {p0, p1}, LN1/b;-><init>(Landroid/content/Context;)V
    invoke-virtual {p0}, LN1/b;->b()V
    return-void
.end method

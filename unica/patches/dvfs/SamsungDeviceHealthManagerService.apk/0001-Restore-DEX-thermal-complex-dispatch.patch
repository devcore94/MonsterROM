+
 .field private static final synthetic j:[Lcom/sec/android/sdhms/thermal/overheatcontrol/overheatcomplex/OverheatComplexType;
 
 
@@ -104,6 +106,16 @@
 
     sput-object v0, Lcom/sec/android/sdhms/thermal/overheatcontrol/overheatcomplex/OverheatComplexType;->i:Lcom/sec/android/sdhms/thermal/overheatcontrol/overheatcomplex/OverheatComplexType;
 
+    new-instance v0, Lcom/sec/android/sdhms/thermal/overheatcontrol/overheatcomplex/OverheatComplexType;

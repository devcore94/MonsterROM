Subject: [PATCH] Port optical FOD to One UI 9 owners

diff --git a/smali/com/samsung/android/biometrics/app/setting/Utils$Config.smali b/smali/com/samsung/android/biometrics/app/setting/Utils$Config.smali
--- a/smali/com/samsung/android/biometrics/app/setting/Utils$Config.smali
+++ b/smali/com/samsung/android/biometrics/app/setting/Utils$Config.smali
@@ -141,7 +141,7 @@
 
     sput-boolean v2, Lcom/samsung/android/biometrics/app/setting/Utils$Config;->FP_FEATURE_SENSOR_IS_IN_DISPLAY_TYPE:Z
 
-    sput-boolean v2, Lcom/samsung/android/biometrics/app/setting/Utils$Config;->FP_FEATURE_SENSOR_IS_ULTRASONIC:Z
+    sput-boolean v3, Lcom/samsung/android/biometrics/app/setting/Utils$Config;->FP_FEATURE_SENSOR_IS_ULTRASONIC:Z
 
     const-string v6, "optical"
 
diff --git a/smali/com/samsung/android/biometrics/app/setting/DisplayStateManager.smali b/smali/com/samsung/android/biometrics/app/setting/DisplayStateManager.smali
--- a/smali/com/samsung/android/biometrics/app/setting/DisplayStateManager.smali
+++ b/smali/com/samsung/android/biometrics/app/setting/DisplayStateManager.smali
@@ -259,7 +259,7 @@
     goto :goto_4
 
     :cond_2
-    const-string p1, "google_touch_display_ultrasonic"
+    const-string p1, "google_touch_display_optical,settings=3"
 
     invoke-virtual {p1, v2}, Ljava/lang/String;->split(Ljava/lang/String;)[Ljava/lang/String;
 

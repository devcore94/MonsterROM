Subject: [PATCH] Constrain old debugfs compatibility to current platform boundaries

Keep the API30 debugfs bridge, but exclude the exact newer protected
objects and permissions that the One UI 9 platform reserves. No One UI 9
assertion or new permission is introduced by this compatibility patch.

diff --git a/mapping/30.0.compat.cil b/mapping/30.0.compat.cil
--- a/mapping/30.0.compat.cil
+++ b/mapping/30.0.compat.cil
@@ -22,5 +22,8 @@
 
-(allow dumpstate debugfs (file (ioctl read getattr lock map open watch watch_reads)))
-(allow dumpstate debugfs_mmc (file (ioctl read getattr lock map open watch watch_reads)))
-(allow dumpstate debugfs_wakeup_sources (file (ioctl read getattr lock map open watch watch_reads)))
+; One UI 9 contract: restrict legacy grant
+(allow dumpstate debugfs (file (getattr map)))
+; One UI 9 contract: restrict legacy grant
+(allow dumpstate debugfs_mmc (file (getattr map)))
+; One UI 9 contract: restrict legacy grant
+(allow dumpstate debugfs_wakeup_sources (file (getattr map)))
 (auditallow dumpstate debugfs (file (ioctl read getattr lock map open watch watch_reads)))
@@ -28,6 +31,9 @@
 (allow init debugfs (dir (getattr relabelfrom)))
-(allow init debugfs (file (getattr relabelfrom)))
+; One UI 9 contract: restrict legacy grant
+(allow init debugfs (file (getattr)))
 (allow init debugfs (lnk_file (getattr relabelfrom)))
 (allow init debugfs_file_type (file (create getattr open read write setattr relabelfrom unlink map)))
-(allow init debugfs_fs_type (filesystem (mount remount unmount getattr relabelfrom associate quotamod quotaget watch)))
+; One UI 9 contract: restrict legacy grant
+(allow init debugfs_tracing_debug (filesystem (mount remount relabelfrom)))
+(allow init debugfs_fs_type (filesystem (unmount getattr associate quotamod quotaget watch)))
 (allow init debugfs_type (dir (getattr relabelto)))
@@ -36,5 +42,12 @@
 
-(allow system_server debugfs_wakeup_sources (file (ioctl read getattr lock map open watch watch_reads)))
+; One UI 9 contract: restrict legacy grant
+(allow system_server debugfs_wakeup_sources (file (getattr map)))
 
 (allow vendor_init debugfs_file_type (file (create getattr open read write setattr relabelfrom unlink map)))
-(allow vendor_init debugfs_fs_type (file (open read setattr map)))
+; One UI 9 contract: restrict legacy grant
+(allow vendor_init unica_api30_compat_grant_1 (file (open read setattr)))
+(allow vendor_init debugfs_fs_type (file (map)))
+
+; Reviewed One UI 9/API30 set intersections (no new permissions).
+(typeattribute unica_api30_compat_grant_1)
+(typeattributeset unica_api30_compat_grant_1 (and debugfs_fs_type (not (abox_debugfs debugfs debugfs_kcov debugfs_kprobes debugfs_mmc debugfs_trustzone debugfs_wakeup_sources sec_debugfs vendor_abox_debugfs vendor_dma_buf_debugfs vendor_ion_debugfs vendor_mali_debugfs vendor_regmap_debugfs vendor_wlbtd_debugfs))))

Subject: [PATCH] bpf: preserve socket marks in UDP sendmsg hooks

The donor's Samsung socket accounting program reads the existing SO_MARK
before applying its routing policy. Backport the socket mark read and
the IPv4 and IPv6 UDP sendmsg setsockopt hooks from Linux v5.15. The UDP
paths take the socket lock before running these programs.

--- a/net/core/filter.c
+++ b/net/core/filter.c
@@ -4992,6 +4992,13 @@
 
 	sock_owned_by_me(sk);
 
+	if (level == SOL_SOCKET && optname == SO_MARK) {
+		if (optlen != sizeof(int))
+			goto err_clear;
+		*((int *)optval) = sk->sk_mark;
+		return 0;
+	}
+
 #ifdef CONFIG_INET
 	if (level == SOL_TCP && sk->sk_prot->getsockopt == tcp_getsockopt) {
 		struct inet_connection_sock *icsk;
@@ -7105,6 +7112,8 @@
 		switch (prog->expected_attach_type) {
 		case BPF_CGROUP_INET4_CONNECT:
 		case BPF_CGROUP_INET6_CONNECT:
+		case BPF_CGROUP_UDP4_SENDMSG:
+		case BPF_CGROUP_UDP6_SENDMSG:
 			return &bpf_sock_addr_setsockopt_proto;
 		default:
 			return NULL;

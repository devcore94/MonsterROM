From 96626b5d24f10330de09259c321e7dedbe377be8 Mon Sep 17 00:00:00 2001
From: MonsterROM Builder <monsterrom-builder@localhost>
Date: Fri, 27 Nov 2026 15:44:03 +0100
Subject: [PATCH 06/16] bpf: support getsockopt in UDP sendmsg hooks

---
 net/core/filter.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/net/core/filter.c b/net/core/filter.c
index 019d9e4ed..570e2c547 100644
--- a/net/core/filter.c
+++ b/net/core/filter.c
@@ -7113,6 +7113,8 @@ sock_addr_func_proto(enum bpf_func_id func_id, const struct bpf_prog *prog)
 		switch (prog->expected_attach_type) {
 		case BPF_CGROUP_INET4_CONNECT:
 		case BPF_CGROUP_INET6_CONNECT:
+		case BPF_CGROUP_UDP4_SENDMSG:
+		case BPF_CGROUP_UDP6_SENDMSG:
 			return &bpf_sock_addr_getsockopt_proto;
 		default:
 			return NULL;

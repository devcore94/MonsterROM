From 8d3e7bc08bcce41f7d00ad8250539e7b73f4bf56 Mon Sep 17 00:00:00 2001
From: MonsterROM Builder <monsterrom-builder@localhost>
Date: Fri, 27 Nov 2026 15:44:03 +0100
Subject: [PATCH 08/16] arm64: add the t2s One UI 9.5 KernelSU Next profile

---
 arch/arm64/configs/oneui95-t2s.config | 10 ++++++++++
 1 file changed, 10 insertions(+)
 create mode 100644 arch/arm64/configs/oneui95-t2s.config

diff --git a/arch/arm64/configs/oneui95-t2s.config b/arch/arm64/configs/oneui95-t2s.config
new file mode 100644
index 000000000..a5feea32f
--- /dev/null
+++ b/arch/arm64/configs/oneui95-t2s.config
@@ -0,0 +1,10 @@
+CONFIG_LOCALVERSION="-Floppy-v1.1.2-KN-t2s"
+CONFIG_KSU_NEXT=y
+CONFIG_KSU=y
+CONFIG_KSU_MANUAL_HOOK=y
+# CONFIG_KSU_SUSFS is not set
+CONFIG_MALI_MIDGARD_R54P3=m
+CONFIG_THINLTO=y
+CONFIG_CFI_CLANG=y
+CONFIG_CFI_CLANG_SHADOW=y
+# CONFIG_CFI_PERMISSIVE is not set

+static int ksu_lookup_su_daemon(struct path *path)
+{
+	const struct cred *daemon_cred = READ_ONCE(ksu_cred);
+	const struct cred *old_cred;
+	struct file *daemon;
+	struct inode *inode;
+	u32 expected_sid = READ_ONCE(ksu_file_sid);
+	u32 sid;
+	int ret = -EACCES;
+
+	if (!daemon_cred || !expected_sid)
+		return -EACCES;
+
+	/* Opening the file initializes its SELinux SID before looking it up. */
+	old_cred = override_creds(daemon_cred);
+	daemon = filp_open(KSUD_PATH, O_RDONLY | O_NOFOLLOW | O_NONBLOCK, 0);
+	revert_creds(old_cred);
+	if (IS_ERR(daemon))
+		return PTR_ERR(daemon);
+
+	inode = file_inode(daemon);
+	security_inode_getsecid(inode, &sid);
+	if (S_ISREG(inode->i_mode) && uid_eq(inode->i_uid, GLOBAL_ROOT_UID) &&
+	    !(inode->i_mode & 0022) && sid == expected_sid) {
+		*path = daemon->f_path;
+		path_get(path);
+		ret = 0;
+	}
+
+	fput(daemon);
+	return ret;
+}
+
 int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
 				 void *__never_use_argv, void *__never_use_envp,
 				 int *__never_use_flags)
 {
-	struct filename *filename;
-	const char su[] = SU_PATH;
-	static const char ksud_path[] = KSUD_PATH;
-	struct ksu_sulog_pending_event *pending_root = NULL;
-	const char *const *sucompat_argv = (const char *const *)__never_use_argv;
+	struct ksu_sulog_pending_event *pending_root;
+	struct filename *filename, *daemon;
+	struct path path;
+	int ret;
 
-	if (unlikely(!filename_ptr))
+	if (unlikely(!filename_ptr) || !ksu_su_compat_enabled)
 		return 0;
 
-	if (!ksu_su_compat_enabled)
+	filename = *filename_ptr;
+	if (IS_ERR(filename) || strcmp(filename->name, SU_PATH))
 		return 0;
 
 	if (!ksu_is_allow_uid_for_current(current_uid().val))
 		return 0;
 
-	filename = *filename_ptr;
-	if (IS_ERR(filename))
+	ret = ksu_lookup_su_daemon(&path);
+	if (ret) {
+		pr_warn_ratelimited("su session: trusted ksud lookup failed: %d\n", ret);
 		return 0;
+	}
+	path_put(&path);
 
-	if (likely(memcmp(filename->name, su, sizeof(su))))
+	daemon = getname_kernel(KSUD_PATH);
+	if (IS_ERR(daemon))
 		return 0;
 
-	pr_info("do_execveat_common su found\n");
+	pending_root = ksu_sulog_capture_root_execve_kern(filename->name, NULL, GFP_KERNEL);
+	ret = escape_with_root_profile();
+	ksu_sulog_emit_pending(pending_root, ret, GFP_KERNEL);
+	if (ret) {
+		putname(daemon);
+		return 0;
+	}
 
-	pending_root = ksu_sulog_capture_root_execve_kern(filename->name, sucompat_argv, GFP_KERNEL);
+	putname(filename);
+	*filename_ptr = daemon;
+	return 1;
+}
 
-	memcpy((void *)filename->name, ksud_path, sizeof(ksud_path));
+void ksu_finish_su_session(int exec_result)
+{
+	struct path path;
+	struct file *exe;
+	bool trusted;
+	int fd;
+
+	/* A failed exec must not return to the old program with the su profile. */
+	if (exec_result || ksu_lookup_su_daemon(&path)) {
+		pr_warn_ratelimited("su session: failed to execute trusted ksud\n");
+		force_sig(SIGKILL);
+		return;
+	}
 
-	escape_with_root_profile();
-	ksu_sulog_emit_pending(pending_root, 0, GFP_KERNEL);
+	exe = get_task_exe_file(current);
+	trusted = exe && path_equal(&exe->f_path, &path);
+	if (exe)
+		fput(exe);
+	path_put(&path);
+	if (!trusted) {
+		pr_warn_ratelimited("su session: executed file differs from trusted ksud\n");
+		force_sig(SIGKILL);
+		return;
+	}
 
-	return 0;
+	/* The exec close-on-exec pass has finished. Keep the descriptor scoped to ksud. */
+	fd = ksu_install_su_fd();
+	if (fd < 0)
+		pr_warn_ratelimited("Failed to install su session fd: %d\n", fd);
+	else
+		pr_info_ratelimited("Installed su session fd for pid %d\n", task_pid_nr(current));
 }
 
 // sucompat: permitted process can execute 'su' to gain root access.

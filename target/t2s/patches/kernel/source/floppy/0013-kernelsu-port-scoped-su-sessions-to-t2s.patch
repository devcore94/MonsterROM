 	int i;
 
 #ifdef CONFIG_KSU_DEBUG
@@ -1090,11 +1091,9 @@ long ksu_supercall_handle_ioctl(const struct file *filp, unsigned int cmd, void
 
 	for (i = 0; ksu_ioctl_handlers[i].handler; i++) {
 		if (cmd == ksu_ioctl_handlers[i].cmd) {
-			// Check permission first
-			if (ksu_ioctl_handlers[i].perm_check &&
-			    !ksu_ioctl_handlers[i].perm_check() &&
-			    !(ksu_ioctl_handlers[i].allow_su_session &&
-			      ksu_is_su_session_fd(filp))) {
+			if (su_session ? !ksu_ioctl_handlers[i].allow_su_session :
+			    (ksu_ioctl_handlers[i].perm_check &&
+			     !ksu_ioctl_handlers[i].perm_check())) {
 				pr_warn("ksu ioctl: permission denied for cmd=0x%x uid=%d\n",
 					cmd, current_uid().val);
 				return -EPERM;
diff --git a/drivers/kernelsu/kernel/supercall/supercall.c b/drivers/kernelsu/kernel/supercall/supercall.c
index ad6cd139f..34a681d54 100644
--- a/drivers/kernelsu/kernel/supercall/supercall.c
+++ b/drivers/kernelsu/kernel/supercall/supercall.c
@@ -30,7 +30,8 @@ uint32_t ksuver_override = 0;
 #define KSU_DRIVER_PERMISSION_SU_SESSION (1UL << 0)
 
 struct ksu_driver_context {
-    unsigned long permissions;
+	unsigned long permissions;
+	struct pid *su_session_owner;
 };
 
 struct ksu_install_fd_tw {
@@ -40,14 +41,22 @@ struct ksu_install_fd_tw {
 
 static int anon_ksu_release(struct inode *inode, struct file *filp)
 {
-    kfree(filp->private_data);
-    pr_info("ksu fd released\n");
-    return 0;
+	struct ksu_driver_context *context = filp->private_data;
+
+	put_pid(context->su_session_owner);
+	kfree(context);
+	pr_info("ksu fd released\n");
+	return 0;
 }
 
 static long anon_ksu_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 {
-    return ksu_supercall_handle_ioctl(filp, cmd, (void __user *)arg);
+	const struct ksu_driver_context *context = filp->private_data;
+
+	if (context->su_session_owner && context->su_session_owner != task_pid(current))
+		return -EPERM;
+
+	return ksu_supercall_handle_ioctl(filp, cmd, (void __user *)arg);
 }
 
 static const struct file_operations anon_ksu_fops = {
@@ -86,9 +95,12 @@ static int ksu_install_fd_with_permissions(unsigned int fd_flags, unsigned long
         return PTR_ERR(filp);
     }
 
-    fd_install(fd, filp);
-    pr_info("ksu fd installed: %d for pid %d\n", fd, current->pid);
-    return fd;
+	if (permissions & KSU_DRIVER_PERMISSION_SU_SESSION)
+		context->su_session_owner = get_task_pid(current, PIDTYPE_PID);
+
+	fd_install(fd, filp);
+	pr_info("ksu fd installed: %d for pid %d\n", fd, current->pid);
+	return fd;
 }
 
 int ksu_install_fd(void)

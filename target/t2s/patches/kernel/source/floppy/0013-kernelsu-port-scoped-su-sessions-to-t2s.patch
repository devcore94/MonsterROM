+static int do_execve_plain(struct filename *filename, struct user_arg_ptr argv,
+			   struct user_arg_ptr envp)
+{
+#if defined(CONFIG_KSU_MANUAL_HOOK) && defined(CONFIG_KSU_NEXT)
+	int ksu_fd = AT_FDCWD;
+	int su_session;
+	int ret;
+
+	su_session = ksu_handle_execveat(&ksu_fd, &filename, &argv, &envp, NULL);
+	ret = do_execveat_common(AT_FDCWD, filename, argv, envp, 0);
+	if (su_session > 0)
+		ksu_finish_su_session(ret);

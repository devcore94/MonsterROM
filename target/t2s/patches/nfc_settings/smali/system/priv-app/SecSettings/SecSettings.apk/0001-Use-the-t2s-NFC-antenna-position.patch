From: MonsterROM_NEXT <monsterrom@localhost>
Subject: [PATCH] Read the t2s NFC antenna at the center position

diff --git a/smali_classes4/com/samsung/android/settings/nfc/NfcAntennaGuideDialog.smali b/smali_classes4/com/samsung/android/settings/nfc/NfcAntennaGuideDialog.smali
--- a/smali_classes4/com/samsung/android/settings/nfc/NfcAntennaGuideDialog.smali
+++ b/smali_classes4/com/samsung/android/settings/nfc/NfcAntennaGuideDialog.smali
@@ -163,20 +163,20 @@
 
     move-result v1
 
-    const-string/jumbo v3, "NfcAntSpf - 27 NfcAntProp "
+    const-string/jumbo v3, "NfcAntSpf - 1 NfcAntProp "
 
     invoke-static {v1, v3, v0}, Landroidx/appcompat/widget/SeslTipPopup$$ExternalSyntheticOutline0;->m(ILjava/lang/String;Ljava/lang/String;)V
 
     if-eq v1, v2, :cond_2
 
-    const/16 v2, 0x1b
+    const/4 v2, 0x1
 
     if-ne v2, v1, :cond_1
 
     goto :goto_0
 
     :cond_1
-    const-string/jumbo p0, "SEC_PRODUCT_FEATURE_NFC_CONFIG_ANTENNA_POSITION Value=27 must be equal to value of ro.vendor.nfc.info.antpos="
+    const-string/jumbo p0, "SEC_PRODUCT_FEATURE_NFC_CONFIG_ANTENNA_POSITION Value=1 must be equal to value of ro.vendor.nfc.info.antpos="
 
     invoke-static {v1, p0}, Landroidx/appcompat/util/SeslRoundedCorner$$ExternalSyntheticOutline0;->m(ILjava/lang/String;)Ljava/lang/String;
 
diff --git a/smali_classes4/com/samsung/android/settings/nfc/NfcSettings.smali b/smali_classes4/com/samsung/android/settings/nfc/NfcSettings.smali
--- a/smali_classes4/com/samsung/android/settings/nfc/NfcSettings.smali
+++ b/smali_classes4/com/samsung/android/settings/nfc/NfcSettings.smali
@@ -1975,7 +1975,7 @@
 
     new-instance v8, Ljava/lang/StringBuilder;
 
-    const-string/jumbo v9, "NfcAntSpf - 27 NfcAntProp "
+    const-string/jumbo v9, "NfcAntSpf - 1 NfcAntProp "
 
     invoke-direct {v8, v9}, Ljava/lang/StringBuilder;-><init>(Ljava/lang/String;)V
 
@@ -1989,14 +1989,14 @@
 
     if-eq v2, v3, :cond_a
 
-    const/16 v8, 0x1b
+    const/4 v8, 0x1
 
     if-ne v8, v2, :cond_9
 
     goto :goto_5
 
     :cond_9
-    const-string/jumbo p0, "SEC_PRODUCT_FEATURE_NFC_CONFIG_ANTENNA_POSITION Value=27 must be equal to value of ro.vendor.nfc.info.antpos="
+    const-string/jumbo p0, "SEC_PRODUCT_FEATURE_NFC_CONFIG_ANTENNA_POSITION Value=1 must be equal to value of ro.vendor.nfc.info.antpos="
 
     invoke-static {v2, p0}, Landroidx/appcompat/util/SeslRoundedCorner$$ExternalSyntheticOutline0;->m(ILjava/lang/String;)Ljava/lang/String;
 
--
